{
  "name": "@cf-wasm/internals",
  "version": "0.1.2",
  "description": "Internals for cf-wasm",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Deo Kumar",
    "email": "deo@fineshopdesign.com",
    "url": "https://github.com/kumardeo"
  },
  "homepage": "https://github.com/fineshopdesign/cf-wasm/tree/main/packages/internals#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fineshopdesign/cf-wasm",
    "directory": "packages/internals"
  },
  "bugs": {
    "url": "https://github.com/fineshopdesign/cf-wasm/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome lint ./src",
    "check": "biome check ./src",
    "check:types": "tsc --noEmit",
    "build": "NODE_ENV=production tsdown",
    "dev": "NODE_ENV=development tsdown --watch"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/polyfills/image-data.js"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./detect-runtime": {
      "types": "./dist/detect-runtime.d.ts",
      "default": "./dist/detect-runtime.js"
    },
    "./polyfills/image-data": {
      "types": "./dist/polyfills/image-data.d.ts",
      "default": "./dist/polyfills/image-data.js"
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  }
}
