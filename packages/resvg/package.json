{
  "name": "@cf-wasm/resvg",
  "version": "0.3.5",
  "description": "A high-performance SVG renderer and toolkit, powered by Rust based resvg.",
  "keywords": [
    "resvg",
    "svg",
    "resvg-js",
    "resvg-wasm",
    "rust",
    "svg2png",
    "svg2img",
    "svg to png",
    "wasm",
    "cloudflare-workers"
  ],
  "license": "MPL-2.0",
  "author": {
    "name": "yisibl"
  },
  "homepage": "https://github.com/fineshopdesign/cf-wasm/tree/main/packages/resvg#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fineshopdesign/cf-wasm",
    "directory": "packages/resvg"
  },
  "bugs": {
    "url": "https://github.com/fineshopdesign/cf-wasm/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome lint ./src",
    "check": "biome check ./src",
    "check:types": "tsc --noEmit",
    "build": "NODE_ENV=production tsdown",
    "dev": "NODE_ENV=development tsdown --watch"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/edge-light.js",
    "./dist/node.js",
    "./dist/workerd.js",
    "./dist/legacy/edge-light.js",
    "./dist/legacy/node.js",
    "./dist/legacy/workerd.js"
  ],
  "type": "module",
  "main": "./dist/workerd.js",
  "module": "./dist/workerd.js",
  "types": "./dist/workerd.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./resvg.wasm": "./dist/lib/resvg.wasm",
    "./legacy/resvg.wasm": "./dist/legacy/lib/resvg.wasm",
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "edge-light": {
        "types": "./dist/edge-light.d.ts",
        "default": "./dist/edge-light.js"
      },
      "workerd": {
        "types": "./dist/workerd.d.ts",
        "default": "./dist/workerd.js"
      },
      "default": {
        "types": "./dist/workerd.d.ts",
        "default": "./dist/workerd.js"
      }
    },
    "./workerd": {
      "types": "./dist/workerd.d.ts",
      "default": "./dist/workerd.js"
    },
    "./edge-light": {
      "types": "./dist/edge-light.d.ts",
      "default": "./dist/edge-light.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./others": {
      "types": "./dist/others.d.ts",
      "default": "./dist/others.js"
    },
    "./legacy": {
      "node": {
        "types": "./dist/legacy/node.d.ts",
        "default": "./dist/legacy/node.js"
      },
      "edge-light": {
        "types": "./dist/legacy/edge-light.d.ts",
        "default": "./dist/legacy/edge-light.js"
      },
      "workerd": {
        "types": "./dist/legacy/workerd.d.ts",
        "default": "./dist/legacy/workerd.js"
      },
      "default": {
        "types": "./dist/legacy/workerd.d.ts",
        "default": "./dist/legacy/workerd.js"
      }
    },
    "./legacy/workerd": {
      "types": "./dist/legacy/workerd.d.ts",
      "default": "./dist/legacy/workerd.js"
    },
    "./legacy/edge-light": {
      "types": "./dist/legacy/edge-light.d.ts",
      "default": "./dist/legacy/edge-light.js"
    },
    "./legacy/node": {
      "types": "./dist/legacy/node.d.ts",
      "default": "./dist/legacy/node.js"
    },
    "./legacy/others": {
      "types": "./dist/legacy/others.d.ts",
      "default": "./dist/legacy/others.js"
    }
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@resvg/resvg-wasm-legacy": "npm:@resvg/resvg-wasm@2.4.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  }
}
