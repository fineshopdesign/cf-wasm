{
  "name": "@cf-wasm/satori",
  "version": "0.3.7",
  "description": "Enlightened library to convert HTML and CSS to SVG.",
  "keywords": [
    "HTML",
    "JSX",
    "SVG",
    "converter",
    "renderer",
    "wasm",
    "cloudflare-workers"
  ],
  "license": "MPL-2.0",
  "author": {
    "name": "Shu Ding",
    "email": "g@shud.in"
  },
  "homepage": "https://github.com/fineshopdesign/cf-wasm/tree/main/packages/satori#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fineshopdesign/cf-wasm",
    "directory": "packages/satori"
  },
  "bugs": {
    "url": "https://github.com/fineshopdesign/cf-wasm/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome lint ./src",
    "check": "biome check ./src",
    "check:types": "tsc --noEmit",
    "build": "NODE_ENV=production tsdown",
    "dev": "NODE_ENV=development tsdown --watch"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/edge-light.js",
    "./dist/node.js",
    "./dist/workerd.js"
  ],
  "type": "module",
  "main": "./dist/workerd.js",
  "module": "./dist/workerd.js",
  "types": "./dist/workerd.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./yoga.wasm": "./dist/lib/yoga.wasm",
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "edge-light": {
        "types": "./dist/edge-light.d.ts",
        "default": "./dist/edge-light.js"
      },
      "workerd": {
        "types": "./dist/workerd.d.ts",
        "default": "./dist/workerd.js"
      },
      "default": {
        "types": "./dist/workerd.d.ts",
        "default": "./dist/workerd.js"
      }
    },
    "./workerd": {
      "types": "./dist/workerd.d.ts",
      "default": "./dist/workerd.js"
    },
    "./edge-light": {
      "types": "./dist/edge-light.d.ts",
      "default": "./dist/edge-light.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./others": {
      "types": "./dist/others.d.ts",
      "default": "./dist/others.js"
    },
    "./jsx": {
      "types": "./dist/jsx.d.ts",
      "default": "./dist/jsx.js"
    }
  },
  "dependencies": {
    "satori": "0.29.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:"
  }
}
