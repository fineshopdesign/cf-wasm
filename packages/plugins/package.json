{
  "name": "@cf-wasm/plugins",
  "version": "0.2.0",
  "description": "Plugins for cf-wasm",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Deo Kumar",
    "email": "deo@fineshopdesign.com",
    "url": "https://github.com/kumardeo"
  },
  "homepage": "https://github.com/fineshopdesign/cf-wasm/tree/main/packages/plugins#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fineshopdesign/cf-wasm",
    "directory": "packages/plugins"
  },
  "bugs": {
    "url": "https://github.com/fineshopdesign/cf-wasm/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome lint ./src",
    "check": "biome check ./src",
    "check:types": "tsc --noEmit",
    "build": "NODE_ENV=production tsdown",
    "dev": "NODE_ENV=development tsdown --watch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./nitro-additional-modules": {
      "types": "./dist/nitro-additional-modules.d.mts",
      "default": "./dist/nitro-additional-modules.mjs"
    },
    "./rollup-additional-modules": {
      "types": "./dist/rollup-additional-modules.d.mts",
      "default": "./dist/rollup-additional-modules.mjs"
    },
    "./vite-additional-modules": {
      "types": "./dist/vite-additional-modules.d.mts",
      "default": "./dist/vite-additional-modules.mjs"
    }
  },
  "peerDependencies": {
    "rollup": "^4.0.0",
    "vite": "^6.1.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "magic-string": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "nitro": "3.0.260903-beta",
    "rollup": "^4.63.1",
    "tsdown": "catalog:",
    "vite": "catalog:"
  }
}
